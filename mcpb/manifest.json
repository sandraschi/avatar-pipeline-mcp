{
  "manifest_version": "0.2",
  "name": "avatar-pipeline-mcp",
  "version": "0.1.0",
  "description": "VRM avatar creative pipeline — VRoid brute-force, Blender validate, VTube staging.",
  "author": { "name": "Sandra Schieder" },
  "server": {
    "type": "python",
    "entry_point": "src/avatar_pipeline_mcp/__main__.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","python","-m","avatar_pipeline_mcp"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "avatar_pipeline", "description": "avatar_pipeline" }
  ]
}
